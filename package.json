{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "@types/bun": "latest",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^24.10.2",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.22",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.1.5",
    "@scalar/hono-api-reference": "^0.9.27",
    "drizzle-orm": "^0.45.0",
    "file-type": "^21.1.1",
    "hono": "^4.10.7",
    "htmx.org": "^2.0.8",
    "ioredis": "^5.8.2",
    "minio": "^8.0.6",
    "postgres": "^3.4.7",
    "uuid": "^13.0.0",
    "wavefile": "^11.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.1.13"
  },
  "scripts": {
    "dev": "bunx @tailwindcss/cli -i ./src/input.css -o ./public/styles.css --watch=always & bun --watch src/index.ts",
    "build:css": "bunx @tailwindcss/cli -i ./src/input.css -o ./public/styles.css",
    "build": "bun run build:css && bun build src/index.ts src/db/seed.ts --target bun --outdir ./dist",
    "start": "bun run dist/index.js",
    "lint": "bunx eslint \"src/**/*.{ts,tsx}\"",
    "db:seed": "bun run src/db/seed.ts",
    "db:migrate": "bunx drizzle-kit push --config=drizzle.config.ts",
    "prepare": "test \"$NODE_ENV\" = \"production\" || husky install",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "bunx eslint --fix"
    ]
  }
}
