# App Configuration
APP_PORT=8888
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Rate limit window in milliseconds (e.g., 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Max requests allowed per key within the window above
RATE_LIMIT_MAX=120

# Database Configuration
DATABASE_USER=audio
DATABASE_PASSWORD=audio123
DATABASE_NAME=audio_db
DATABASE_URL=postgres://audio:audio123@db:5432/audio_db

# MinIO Configuration
MINIO_ENDPOINT=http://minio:9000
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=audio

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Whisper Configuration
WHISPER_MODEL_SIZE=
WHISPER_DEVICE=
WHISPER_COMPUTE_TYPE=
WORKER_DEVICE_MODE=
WORKER_DEV_TARGET=
WORKER_PROD_TARGET=

# Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
